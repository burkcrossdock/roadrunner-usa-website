# Public site URL used for metadata. Set this to the live https origin on Render.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4317

# Inbox for quote, tracking, career, and contact submissions.
FORM_TO_EMAIL=info@rdrunnerusa.com

# Where JSON copies are written. Defaults to data/submissions.
# On Render the disk is ephemeral unless you mount a persistent disk and set this path.
# SUBMISSIONS_DIR=/var/data/submissions

# Option A — SMTP. Used first when SMTP_HOST, SMTP_USER, and SMTP_PASS are all set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="RoadRunner USA <info@rdrunnerusa.com>"

# Option B — Resend. Used when SMTP is not set.
# Verify the sending domain in Resend before mail to info@rdrunnerusa.com will deliver.
# RESEND_API_KEY=
# RESEND_FROM="RoadRunner USA <info@rdrunnerusa.com>"

# Option C — any HTTPS endpoint that accepts a JSON POST of the submission.
# FORM_WEBHOOK_URL=
